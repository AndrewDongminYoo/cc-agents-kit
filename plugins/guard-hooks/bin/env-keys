#!/usr/bin/python3 -IS
"""Print the key names of dotenv files, never their values.

secrets-path-guard leaves a command that is exactly `env-keys <dotenv path>...`
to the ordinary permission decision in every mode, so this output must stay
value-free: only names that start an assignment line are printed, lines inside
a quoted multi-line value are skipped, and no message repeats file content.
"""

import errno
import os
import re
import stat
import sys
from pathlib import Path

NAME = re.compile(r"\.env(?:\.[A-Za-z0-9-]+)*", re.I)
ASSIGNMENT = re.compile(r"[ \t]*(?:export[ \t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \t]*=.*")
USAGE = "usage: env-keys <dotenv file>..."


# Quotes that may stay open across lines and are tracked exactly.
QUOTES = ("'", '"', "$'")


def scan(line, stack):
    """Read one line as the shell would and return what is still open after it.

    stack holds the open quotes ('...', "...", $'...'), backtick and $( or (
    groups, and ${ braces. The result is (stack, joined, stop): joined when an
    unquoted backslash ends the line, stop at a heredoc. A misread must only
    ever hide a later key, never show part of a value.
    """
    i, n = 0, len(line)
    while i < n:
        char, top = line[i], stack[-1] if stack else None
        pair = line[i : i + 2]
        if top == "'":
            if char == "'":
                stack.pop()
        elif top in ('"', "$'"):
            if char == "\\":
                i += 1
            elif char == top[-1]:
                stack.pop()
            elif top == '"' and pair in ("$(", "${"):
                stack.append(pair[1])
                i += 1
            elif top == '"' and char == "`":
                stack.append(char)
        else:
            # Unquoted, or inside a backtick, $( or ${: quotes nest here.
            if char == "\\":
                if i + 1 == n:
                    return stack, True, False
                i += 1
            elif char == "#" and (i == 0 or line[i - 1] in " \t"):
                break
            elif pair == "<<":
                return stack, False, True
            elif char == "`" and top == "`":
                stack.pop()
            elif pair == "$'":
                stack.append(pair)
                i += 1
            elif char in ("'", '"', "`", "("):
                stack.append(char)
            elif pair == "${":
                stack.append("{")
                i += 1
            elif (char == ")" and top == "(") or (char == "}" and top == "{"):
                stack.pop()
        i += 1
    return stack, False, False


def keys(text):
    stack, joined = [], False
    for line in text.split("\n"):
        line = line[:-1] if line.endswith("\r") else line
        if not stack and not joined:
            match = ASSIGNMENT.fullmatch(line)
            if match:
                yield match[1]
        stack, joined, stop = scan(line, stack)
        # A heredoc body is data, and a command substitution, group or array
        # left open across lines can hold a ) that is not its end (a case
        # pattern): stop rather than guess where either ends.
        if stop or any(entry not in QUOTES for entry in stack):
            return


def read_regular_file(path):
    """Read path only when its last component is a regular file, not a link.

    The name check covers the operand, not what a link named .env points at,
    such as a private key whose padded base64 lines would read as keys.
    """
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise OSError(errno.EINVAL, "not a regular file")
        return handle.read().decode("utf-8", "replace")


def main(argv):
    if not argv or any(arg.startswith("-") for arg in argv):
        print(USAGE, file=sys.stderr)
        return 2
    for arg in argv:
        if not NAME.fullmatch(Path(arg).name):
            print(f"env-keys: {arg}: not a dotenv file name", file=sys.stderr)
            return 2
    status = 0
    for arg in argv:
        try:
            text = read_regular_file(arg)
        except OSError as error:
            reason = error.strerror
            if error.errno == errno.ELOOP:
                reason = "a symbolic link; name the dotenv file itself"
            print(f"env-keys: {arg}: {reason}", file=sys.stderr)
            status = 1
            continue
        for key in keys(text):
            print(f"{arg}:{key}" if len(argv) > 1 else key)
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
