[0.000, "o", "\u001b[38;5;203mPreToolUse:Bash hook error: [${CLAUDE_PLUGIN_ROOT}/hooks/zsh-quoting-guard.sh]\u001b[0m\r\n\u001b[38;5;203mBlocked: unquoted glob pattern (-name *). zsh expands it against the CWD\u001b[0m\r\n"]
[0.000, "o", "\u001b[38;5;203mbefore the tool sees it: no match aborts the whole command, several\u001b[0m\r\n"]
[0.000, "o", "\u001b[38;5;203mbecome a filename list the tool rejects, and exactly one silently\u001b[0m\r\n\u001b[38;5;203msearches that single file instead of the pattern. Quote it: -name '*.md'.\u001b[0m\r\n"]
[1.208, "o", "\u001b[38;5;114m# /plugin install guard-hooks@cc-agents-kit\u001b[0m\r\n"]
