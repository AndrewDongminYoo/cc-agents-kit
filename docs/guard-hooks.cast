[0.617, "o", "\u001b[38;5;203m# exit 0, and docs/DESIGN.md is missing. Nothing said so.\u001b[0m\r\n\u001b[38;5;203m# zsh expanded *.md first, so find actually ran as:\u001b[0m\r\n"]
[0.000, "o", "\u001b[38;5;203m#   find . -name README.md\u001b[0m\r\n"]
